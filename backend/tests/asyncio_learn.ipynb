   "source": [
    "import asyncio\n",
    "\n",
    "async def hello():\n",
    "    print(\"Hello world!\")\n",
    "    # 异步调用asyncio.sleep(1):\n",
    "    await asyncio.sleep(1)\n",
    "    print(\"Hello again!\")\n",
    "\n",
    "asyncio.run(hello())\n"
   ]
